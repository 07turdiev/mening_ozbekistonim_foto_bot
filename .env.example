# ==== ASOSIY SOZLAMALAR ====
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Administratorlar (Telegram ID, vergul bilan)
ADMIN_IDS=123456789,987654321

# ==== TANLOV MUDDATI (YYYY-MM-DD) ====
START_DATE=2026-08-27
END_DATE=2026-09-05

# ==== FOTO TALABLARI ====
MAX_PHOTOS=3
MIN_WIDTH=3000
MIN_HEIGHT=2000
MAX_FILE_MB=20

# ==== IXTIYORIY ====
# Majburiy obuna kanali (@username yoki -100...). Bo'sh qoldirilsa - tekshirilmaydi
CHANNEL_ID=
CHANNEL_URL=

# Qabul qilingan suratlar nusxasi yuboriladigan yopiq kanal/guruh ID (ixtiyoriy)
ARCHIVE_CHAT_ID=

# Murojaat uchun
CONTACT_INFO=+998 71 000 00 00 | @admin_username

# Moderatsiya yoqilsinmi (1 - ha, 0 - yo'q)
MODERATION=1

TIMEZONE_OFFSET=5

# Sinov rejimi: 1 - tanlov muddati tekshirilmaydi (faqat lokal test uchun!)
# Rasmiy ishga tushirishdan oldin ALBATTA 0 ga qaytaring
TEST_MODE=0
